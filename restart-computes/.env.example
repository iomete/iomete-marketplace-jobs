# Database host must be reachable from where the script runs.
# - Local Python with host-side port-forwarding may use: localhost
# - Local Docker on Mac/Windows with host-side port-forwarding should use: host.docker.internal
# - Client / cluster environments should use their actual reachable DB host or service name
DB_HOST=
DB_PORT=
DB_NAME=iomete_core_db
DB_USER=
DB_PASSWORD=

API_BASE_URL=
API_TOKEN=

# Safety
DRY_RUN=true

# Optional settings
# Defaults below normally do not need to be changed.
REQUEST_TIMEOUT=30
API_RETRY_COUNT=1
API_RETRY_DELAY_SECONDS=2

STOP_POLL_INTERVAL_SECONDS=2
STOP_POLL_MAX_INTERVAL_SECONDS=12
STOP_POLL_TIMEOUT_SECONDS=90
STOP_POLL_BACKOFF_MULTIPLIER=1.5

START_POLL_INTERVAL_SECONDS=2
START_POLL_MAX_INTERVAL_SECONDS=12
START_POLL_TIMEOUT_SECONDS=120
START_POLL_BACKOFF_MULTIPLIER=1.5